.blender-toolkit/
node_modules/
__pycache__/
.DS_Store
.agentic-sdlc/
.claude/
.learnings/
.sdlc/
*-workspace/

# Tessl's dependency manifest — {name, mode, dependencies}, written by `tessl install`. It is
# NOT the project link: an eval run resolves its project server-side from the git remote. It is
# maintainer-local because the vendored dependencies it names are, and a clone does not need them.
tessl.json

# Tessl's own published plugins, installed by `tessl install`. They belong to another
# workspace, and inside a pack boundary they would ship in our artifact.
.tessl/plugins/

# Per-agent symlink farms `tessl install` points at .tessl/plugins/ above. Committing them would
# publish dangling symlinks, because their targets are ignored. `.github/skills/` matters most:
# unlike the others it sits inside a directory this repo does track.
.agents/
.codex/
.cursor/
.vscode/
.github/skills/

# An SDLC run log a session dropped inside the plugin's hooks directory. It is transcript, not
# payload, and everything under a plugin root is a candidate for the pack.
plugins/doc-this/hooks/docs/

# Local credentials. Untracked is not enough in a public repo — an untracked-but-unignored file
# is one `git add -A` from being published, which is why test-publication-safety.mjs scans
# untracked files too and flags this one.
.env
.env.*
!.env.example
